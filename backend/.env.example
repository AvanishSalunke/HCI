# Copy this file to .env and fill in the values. Never commit the real .env.

# MongoDB Atlas connection string
MONGO_URI=

# Any long random text; used to sign login tokens
JWT_SECRET=

# Website address(es) allowed to call this API, comma separated
# Leave empty while developing locally
FRONTEND_URL=

# Push notification keys. Make them once with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional, only if your network blocks MongoDB's DNS lookups
# DNS_SERVERS=8.8.8.8,1.1.1.1
